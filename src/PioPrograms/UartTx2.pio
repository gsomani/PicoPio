.program uartTx2

; What does opt do ?

.side_set 1 opt
    pull     side 1 [7]; stop bit  (pull block (data from TxFIFO into OSR) + out pins 1,1 + delay 15)
    set x,7  side 0 [7] ; set x = 7 and (out pins 1,0) send start bit (1 cycle for instruction and 7 delay cycles)

bitLoop:
    out pins, 1
    jmp x-- bitloop[6]
